# Copy to .env and fill in. Never commit the real .env.

# --- Core ---------------------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=billow.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://billow.example.com
DJANGO_TIME_ZONE=UTC

# Previous secret keys, kept until old sessions expire (comma separated).
#DJANGO_SECRET_KEY_FALLBACKS=

# Trailing slash required.
#DJANGO_ADMIN_URL=admin/

# Redirect to HTTPS, send HSTS and mark cookies secure. Defaults to on unless
# DJANGO_DEBUG is on; turn off only when serving plain HTTP on purpose.
#DJANGO_HTTPS_ONLY=True
#DJANGO_HSTS_SECONDS=31536000

# --- Storage ------------------------------------------------------------
# Point these at a mounted volume when running in Docker.
#DJANGO_DB_PATH=/data/db.sqlite3
#DJANGO_MEDIA_ROOT=/data/media

# --- Email --------------------------------------------------------------
# Mail is printed to stdout until DJANGO_EMAIL_HOST is set.
#DJANGO_EMAIL_HOST=smtp.example.com
#DJANGO_EMAIL_PORT=587
#DJANGO_EMAIL_HOST_USER=
#DJANGO_EMAIL_HOST_PASSWORD=
# STARTTLS (port 587) or implicit TLS (port 465); never both.
#DJANGO_EMAIL_USE_TLS=True
#DJANGO_EMAIL_USE_SSL=False
#DJANGO_EMAIL_TIMEOUT=10
#DJANGO_DEFAULT_FROM_EMAIL=billow@example.com
# Sender of error mail; defaults to DJANGO_DEFAULT_FROM_EMAIL.
#DJANGO_SERVER_EMAIL=billow@example.com

# --- Operations ---------------------------------------------------------
# Recipients of unhandled-error mail (comma separated).
#DJANGO_ADMINS=ops@example.com
#DJANGO_LOG_LEVEL=INFO
