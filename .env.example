# Copy to `.env` and fill in the uncommented variables: without them the app
# either refuses to start or refuses to serve the traffic you point at it. The
# commented-out ones show the default `config/settings.py` uses; uncomment only
# to change it.
#
# Never commit the real `.env`. Compose reads it twice over: once to interpolate
# `${...}` in the compose files themselves, and once as the values `env_file:`
# exports into the containers. `config/settings.py` reads it a third time, but
# only where it can see the file: on the host, and in the development stack,
# which bind-mounts the working tree at /app. The production image excludes
# `.env` and mounts nothing, so there the containers get these values from the
# environment alone. Everything below is in effect either way.


# ===================================================
# Core
# ===================================================

# Signs sessions, CSRF tokens and password-reset links. Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Fill this in even for local development. `config/settings.py` falls back to a
# throwaway key under DJANGO_DEBUG, but only when the variable is absent
# entirely — the blank entry below counts as set, and Django rejects an empty
# key outright. Delete the line rather than blanking it if you want that
# fallback.
#
# A generated key can contain a `$`, which reaches the app intact — the compose
# files read this with `format: raw` — but compose still prints a harmless
# "variable is not set" warning for it while parsing the file. Regenerate the
# key if that noise bothers you; nothing is truncated either way.
DJANGO_SECRET_KEY=

# Hostnames this app answers to. Requests for anything else are rejected.
# `localhost` and `127.0.0.1` are always accepted on top of whatever is here,
# because that is how the container healthcheck reaches the app.
DJANGO_ALLOWED_HOSTS=billow.example.com

# Previous secret keys, newest first. Set during a key rotation so sessions
# signed with the old key stay valid; remove once they have expired.
# DJANGO_SECRET_KEY_FALLBACKS=

# Never true outside local development: it leaks settings and stack traces.
# It also flips the defaults of several settings below, so turning it on is not
# only about the error page.
# DJANGO_DEBUG=false

# Origins allowed to submit forms, including the scheme. Needed once the app is
# served over HTTPS under its real name, since Django matches the Origin header
# against this rather than against ALLOWED_HOSTS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://billow.example.com


# ===================================================
# Database
# ===================================================

# Connection URL. Under Docker, `localhost` names the container itself: a
# Postgres running on your own machine is reached as host.docker.internal,
# which the compose files map to the bridge gateway.
#
# Nothing in either stack runs a database. This app is stateless and mounts no
# volume; the server this points at is what a backup has to cover.
DJANGO_DATABASE_URL=postgres://user:password@localhost:5432/billow

# Seconds a connection is reused across requests before being reopened; 0
# reconnects on every request. Each thread holds its own, so what the server
# ends up seeing is set by GUNICORN_WORKERS and GUNICORN_THREADS below;
# docker/gunicorn.conf.py does that arithmetic.
# DJANGO_CONN_MAX_AGE=60

# Milliseconds before Postgres aborts a statement, so one runaway query cannot
# hold locks indefinitely. It has to stay above the slowest report this app
# legitimately runs. Migrations are exempt: they set their own.
# DJANGO_STATEMENT_TIMEOUT_MS=30000


# ===================================================
# Object storage
# ===================================================
# Where uploads live. Required once DJANGO_DEBUG is off, and ignored entirely
# while it is on: development writes to DJANGO_MEDIA_ROOT on local disk instead,
# so none of this has to be filled in to work on the app.
#
# Any S3-compatible provider works, Backblaze B2 and Cloudflare R2 included —
# the endpoint below is what picks one. Deployed containers have a read-only
# filesystem and no volume, so there is nowhere else for an upload to go.

# DJANGO_S3_BUCKET=billow-media
# DJANGO_S3_ACCESS_KEY_ID=
# DJANGO_S3_SECRET_ACCESS_KEY=

# The provider's S3 API endpoint, which is what makes this B2 rather than AWS.
#   Backblaze B2:   https://s3.<region>.backblazeb2.com
#   Cloudflare R2:  https://<account-id>.r2.cloudflarestorage.com
# DJANGO_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com

# Required by B2 and part of its endpoint; R2 wants the literal `auto`.
# DJANGO_S3_REGION=us-west-004

# Hostname serving the bucket's objects to browsers — a Cloudflare CDN domain
# in front of it, typically. Set it and generated URLs point at the CDN rather
# than at the origin, so objects are not fetched from the bucket per request
# and egress is not billed per view. Leave unset to serve from the endpoint.
# DJANGO_S3_CUSTOM_DOMAIN=media.example.com

# Whether object URLs carry a time-limited signature. Keep it on for anything
# private, which for billing attachments is all of it: with it off, every URL
# is public forever to anyone who learns it, and the bucket must be public for
# them to work at all. Turning it off in front of a CDN is what makes caching
# effective, so it is a real trade and not a default to flip casually.
# DJANGO_S3_QUERYSTRING_AUTH=true
# DJANGO_S3_QUERYSTRING_EXPIRE=3600

# `virtual` (bucket in the hostname) suits B2 and R2. Switch to `path` only for
# a provider that cannot do virtual-hosted style, such as a local MinIO.
# DJANGO_S3_ADDRESSING_STYLE=virtual

# Where uploads go while DJANGO_DEBUG is on. A relative path is taken from the
# repository root; an absolute path is used as given.
# DJANGO_MEDIA_ROOT=media


# ===================================================
# Email
# ===================================================

# SMTP server to send through. Leave it unset and mail is written to stdout
# instead of being sent, which is what you want in development — or point it at
# a local catcher such as Mailpit on localhost:1025 with TLS off. Under Docker
# that catcher is reached as host.docker.internal, for the reason given under
# DJANGO_DATABASE_URL above.
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587

# Leave both unset for an SMTP server that does not require authentication.
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=

# STARTTLS on port 587, implicit TLS on port 465. One or the other, never both:
# a server offered both at once fails in ways that read like a network problem.
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_USE_SSL=false

# Seconds before a hung SMTP conversation is abandoned. Worth keeping low: this
# blocks the request that triggered the mail.
# DJANGO_EMAIL_TIMEOUT=10

# From address on mail this app sends.
# DJANGO_DEFAULT_FROM_EMAIL=billow@example.com

# From address on unhandled-error mail specifically, which some providers
# require to differ from the above. Defaults to DJANGO_DEFAULT_FROM_EMAIL.
# DJANGO_SERVER_EMAIL=billow@example.com


# ===================================================
# Security
# ===================================================

# One switch for everything that assumes HTTPS: the redirect to https, the HSTS
# header, and the Secure flag on the session and CSRF cookies. Defaults to on
# unless DJANGO_DEBUG is on.
#
# Turn it off only when serving plain HTTP on purpose — an internal network, a
# staging box with no certificate — which is the case this exists for: it lets
# such a deployment run without DJANGO_DEBUG, rather than trading one for the
# other. TLS terminated at a reverse proxy is not that case: leave it on, and
# have the proxy set X-Forwarded-Proto (and strip any copy a client sent, since
# settings.py trusts it).
# DJANGO_HTTPS_ONLY=true

# HSTS lifetime in seconds. Browsers cache this and honour it until it expires,
# so a value set while HTTPS is not yet working on every subdomain is a mistake
# that cannot be taken back by unsetting it. Ignored when HTTPS_ONLY is off.
# DJANGO_HSTS_SECONDS=31536000

# Path to the admin, with the trailing slash. Moving it off the well-known one
# cuts most drive-by credential stuffing; it is obscurity, and no substitute for
# strong passwords.
# DJANGO_ADMIN_URL=admin/


# ===================================================
# Localization
# ===================================================

# Timestamps are stored in UTC regardless; this is what users see. Separate
# from TZ below, which sets the containers' own clock.
# DJANGO_TIME_ZONE=UTC


# ===================================================
# Operations
# ===================================================

# Who receives mail about unhandled errors, comma separated. Requires a working
# SMTP host above; with none configured those reports go to stdout with
# everything else.
# DJANGO_ADMINS=ops@example.com

# One of DEBUG, INFO, WARNING, ERROR, CRITICAL. Logs go to stdout, where the
# container log driver collects and rotates them.
# DJANGO_LOG_LEVEL=INFO


# ===================================================
# Docker
# ===================================================
# Read by the compose files, not by Django. Ignored if you run on the host.

# The containers' system clock: what `date` and log timestamps use. Separate
# from DJANGO_TIME_ZONE above, which only changes how Django formats timestamps
# it shows to users and has no effect on the container itself. Picking this up
# needs a restart, not a rebuild.
# TZ=UTC

# Host port the app is published on — change it here and nowhere else, which is
# what you want when port 8000 is already taken by another stack on this
# machine. Whatever it is, the hostname serving it has to appear in
# DJANGO_ALLOWED_HOSTS above. In production this is published on 127.0.0.1
# only, for the proxy to forward to; in development, on every interface.
# DOCKER_HOST_PORT=8000


# --- Development (compose.yaml) ---

# User and group the dev containers run as. They write into the bind-mounted
# working tree — the database, new migrations, the compiled stylesheet — so this
# has to be you, or those files land root-owned in your repository where your
# editor and git cannot touch them without sudo. Find yours with:
#   id -u && id -g
# Changing these needs `docker compose build`, not just `up`: the uid is baked
# into the image, which is what makes the volumes it seeds writable.
# DOCKER_UID=1000
# DOCKER_GID=1000

# Ceilings on the tailwind watcher. A file watcher over a bind-mounted tree can
# spin hard when something goes wrong, and these bound the damage to a fraction
# of the machine rather than the whole of it. Raise them only if the stylesheet
# genuinely takes long enough to compile to notice.
# DOCKER_TAILWIND_CPU_LIMIT=0.5
# DOCKER_TAILWIND_MEMORY_LIMIT=512M


# --- Production (compose.prod.yaml) ---

# The published image, without a tag. No default: this file is copied per app,
# and a copy that does not set it would deploy under the previous app's name.
# It is `ghcr.io/<owner>/<repo>` of the repository this copy lives in,
# lowercased, which is exactly what .github/workflows/publish.yml pushes to.
# compose.prod.yaml refuses to start without it.
DOCKER_IMAGE=ghcr.io/konfpa/billow

# Which tag to run. `latest` follows the newest v* tag, since that workflow
# publishes only on a tag and moves `latest` to it. A deployment that should
# not change under itself pins a version (1.2.3) or a commit (sha-<40 hex>),
# both of which that workflow publishes.
# DOCKER_IMAGE_TAG=latest

# Ceilings on the django container, not targets; see compose.prod.yaml, where
# they are applied, for what they are for.
# DOCKER_CPU_LIMIT=2.0
# DOCKER_MEMORY_LIMIT=1g

# Log rotation. Without a bound the container's log file grows until it fills
# the disk, taking the database and everything else on the host with it.
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=3


# ===================================================
# Gunicorn
# ===================================================
# Production only, read by docker/gunicorn.conf.py, which carries the reasoning
# behind these defaults. Changing any of them is a restart, never a rebuild.

# Concurrency, chosen rather than derived from the CPU count, and not free
# either: each thread holds a database connection for DJANGO_CONN_MAX_AGE
# seconds. Raise these only with the database's connection limit in hand.
# GUNICORN_WORKERS=2
# GUNICORN_THREADS=4

# What bounds memory growth: a worker retires after this many requests and is
# replaced by a fresh fork. The jitter staggers those retirements so that the
# workers do not all restart at once.
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# Load the app in the master and fork workers from it, so the interpreter and
# every import are shared copy-on-write instead of paid for per worker.
# GUNICORN_PRELOAD=true

# A request still running after GUNICORN_TIMEOUT seconds is treated as a hung
# worker and killed, so it has to stay above the slowest thing a request
# legitimately does. On shutdown, workers get GUNICORN_GRACEFUL_TIMEOUT to
# finish what they are holding; raise it past 45 and `stop_grace_period` in
# compose.prod.yaml has to be raised with it, or Docker kills the container
# mid-drain and the graceful shutdown never happens.
# GUNICORN_TIMEOUT=60
# GUNICORN_GRACEFUL_TIMEOUT=30

# Slightly above the proxy's own keepalive, so connections are reused rather
# than reopened per request.
# GUNICORN_KEEPALIVE=5

# GUNICORN_LOG_LEVEL=info

# Which peers may set X-Forwarded-*. The proxy arrives over Docker's bridge
# rather than as 127.0.0.1, hence the default. It is safe only because the
# container publishes to the loopback interface, so nothing else can connect.
# GUNICORN_FORWARDED_ALLOW_IPS=*
